{
    "extends": "expo/tsconfig.base",
    "compilerOptions": {
        "strict": true,
        "noUnusedLocals": true,
        "noUnusedParameters": true,
        "noFallthroughCasesInSwitch": true,
        "paths": {
            "@/assets/*": ["./assets/*"],
            "@/*": ["./src/*"],
        },
    },
    "include": ["**/*.ts", "**/*.tsx", "expo-env.d.ts"],
    "exclude": ["node_modules", "android", "ios"],
}
